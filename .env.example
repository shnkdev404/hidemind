# --- Hindsight -----------------------------------------------------------
# Hindsight Cloud endpoint (from ui.hindsight.vectorize.io) or local Docker: http://localhost:8888
# Leave empty to run Munshi in "memory off" mode (useful for UI work without credentials).
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
BANK_ID=munshi-ap

# --- LLM (Groq) ----------------------------------------------------------
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b

# --- AP policy -----------------------------------------------------------
AUTO_RESOLVE_MAX_INR=200000
ESCALATE_ABOVE_INR=500000

# --- Runtime -------------------------------------------------------------
# Max concurrent triage calls while simulating a week (keep low on Groq free tier)
SIM_CONCURRENCY=3
